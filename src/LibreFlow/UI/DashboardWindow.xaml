<Window x:Class="LibreFlow.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Libre Flow" Width="1120" Height="760" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0B0B0C">
    <Grid>
        <TextBlock x:Name="Fallback" Foreground="#B0B0B0" FontSize="14" TextWrapping="Wrap" Margin="40"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <wv:WebView2 x:Name="Web" DefaultBackgroundColor="#0B0B0C"/>
    </Grid>
</Window>
